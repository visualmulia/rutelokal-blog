---
// PromoBanner.astro - Animated Responsive Banner for Komikoe
---

<aside class="promo-banner-section" aria-label="Promosi Komikoe">
	<div class="container">
		<div class="promo-card">
			<!-- Background Glowing Orbs -->
			<div class="glow-orb orb-1"></div>
			<div class="glow-orb orb-2"></div>

			<div class="promo-content">
				<!-- Header Badge -->
				<div class="promo-badge-row">
					<span class="badge-tag">
						<span class="pulse-dot"></span>
						REKOMENDASI KOMIK
					</span>
					<span class="badge-free">100% GRATIS AKSES</span>
				</div>

				<!-- Main Headline & Subtitle -->
				<h3 class="promo-title">
					Suka Baca Komik? Jelajahi Ribuan Manga & Komik di <span class="brand-highlight">Komikoe</span>!
				</h3>
				<p class="promo-desc">
					Platform digitalisasi dan baca komik gratis untuk penikmat cerita bergambar di Indonesia. Koleksi lengkap dari Manga Jepang, Superhero US, hingga cerita petualangan Eropa legendaris.
				</p>

				<!-- Feature Pills -->
				<div class="promo-pills">
					<span class="pill">📖 Koleksi Manga Lengkap</span>
					<span class="pill">🦸‍♂️ Komik US & Superhero</span>
					<span class="pill">🏰 Petualangan Klasik Eropa</span>
					<span class="pill">⚡ Tampilan Cepat & Mobile Friendly</span>
				</div>
			</div>

			<!-- Call to Action Side -->
			<div class="promo-action">
				<div class="floating-icon-wrapper">
					<span class="comic-emoji">📚</span>
					<span class="sparkle-emoji">✨</span>
				</div>
				<a 
					href="https://komikoe.web.id" 
					target="_blank" 
					rel="noopener noreferrer" 
					class="promo-btn"
					title="Baca Komik Gratis di Komikoe.web.id"
				>
					<span class="btn-text">Buka Komikoe Sekarang</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow">
						<line x1="5" y1="12" x2="19" y2="12"></line>
						<polyline points="12 5 19 12 12 19"></polyline>
					</svg>
					<div class="btn-shimmer"></div>
				</a>
				<span class="promo-subnote">Tanpa ribet & langsung baca di browser</span>
			</div>
		</div>
	</div>
</aside>

<style>
	.promo-banner-section {
		padding: 3rem 1.5rem 2rem 1.5rem;
		position: relative;
	}

	.promo-card {
		position: relative;
		overflow: hidden;
		background: linear-gradient(135deg, #0F172A 0%, #1E1B4B 50%, #172554 100%);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 1.5rem;
		padding: 2.25rem 2.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2.5rem;
		box-shadow: 0 16px 36px -10px rgba(15, 23, 42, 0.35), 0 0 0 1px rgba(255, 255, 255, 0.05);
		transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.35s ease;
	}

	.promo-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 22px 48px -8px rgba(15, 23, 42, 0.45), 0 0 24px rgba(245, 158, 11, 0.15);
	}

	/* Ambient Glowing Background Orbs */
	.glow-orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(60px);
		pointer-events: none;
		opacity: 0.25;
		z-index: 1;
	}

	.orb-1 {
		width: 250px;
		height: 250px;
		background: #F59E0B;
		top: -40px;
		right: 25%;
		animation: pulse-glow 6s ease-in-out infinite alternate;
	}

	.orb-2 {
		width: 200px;
		height: 200px;
		background: #8B5CF6;
		bottom: -40px;
		left: 10%;
		animation: pulse-glow 8s ease-in-out infinite alternate-reverse;
	}

	@keyframes pulse-glow {
		0% { transform: scale(1); opacity: 0.2; }
		100% { transform: scale(1.25); opacity: 0.35; }
	}

	/* Content Column */
	.promo-content {
		position: relative;
		z-index: 2;
		flex: 1 1 65%;
	}

	.promo-badge-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.85rem;
		flex-wrap: wrap;
	}

	.badge-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		background: rgba(245, 158, 11, 0.15);
		border: 1px solid rgba(245, 158, 11, 0.4);
		color: #FBBF24;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.5px;
		padding: 0.25rem 0.65rem;
		border-radius: 9999px;
		text-transform: uppercase;
	}

	.pulse-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background-color: #10B981;
		box-shadow: 0 0 8px #10B981;
		animation: blink-animation 1.6s infinite ease-in-out;
	}

	@keyframes blink-animation {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.4; transform: scale(0.85); }
	}

	.badge-free {
		background: rgba(16, 185, 129, 0.15);
		border: 1px solid rgba(16, 185, 129, 0.4);
		color: #34D399;
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.25rem 0.65rem;
		border-radius: 9999px;
	}

	.promo-title {
		font-size: clamp(1.25rem, 2.5vw, 1.65rem);
		font-weight: 800;
		color: #FFFFFF;
		line-height: 1.35;
		margin-bottom: 0.65rem;
		letter-spacing: -0.3px;
	}

	.brand-highlight {
		background: linear-gradient(90deg, #F59E0B, #FBBF24, #FB923C);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		font-weight: 900;
		text-shadow: 0 0 20px rgba(245, 158, 11, 0.3);
	}

	.promo-desc {
		font-size: 0.95rem;
		color: #94A3B8;
		line-height: 1.55;
		margin-bottom: 1.15rem;
		max-width: 620px;
	}

	.promo-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.pill {
		font-size: 0.78rem;
		font-weight: 500;
		color: #E2E8F0;
		background: rgba(255, 255, 255, 0.07);
		border: 1px solid rgba(255, 255, 255, 0.12);
		padding: 0.25rem 0.65rem;
		border-radius: 0.5rem;
		backdrop-filter: blur(4px);
		transition: background 0.2s ease;
	}

	.pill:hover {
		background: rgba(255, 255, 255, 0.12);
		border-color: rgba(245, 158, 11, 0.4);
	}

	/* Action Column */
	.promo-action {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		flex: 1 1 35%;
		max-width: 280px;
	}

	.floating-icon-wrapper {
		position: relative;
		font-size: 2.2rem;
		margin-bottom: 0.75rem;
		animation: float-badge 3.5s ease-in-out infinite;
	}

	.sparkle-emoji {
		position: absolute;
		top: -8px;
		right: -12px;
		font-size: 1.25rem;
		animation: sparkle-rotate 4s linear infinite;
	}

	@keyframes float-badge {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-7px); }
	}

	@keyframes sparkle-rotate {
		0% { transform: rotate(0deg) scale(1); }
		50% { transform: rotate(180deg) scale(1.2); }
		100% { transform: rotate(360deg) scale(1); }
	}

	.promo-btn {
		position: relative;
		overflow: hidden;
		width: 100%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
		color: #1E293B;
		font-weight: 800;
		font-size: 0.98rem;
		padding: 0.85rem 1.4rem;
		border-radius: 0.85rem;
		text-decoration: none;
		box-shadow: 0 8px 20px -4px rgba(245, 158, 11, 0.45);
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.promo-btn:hover {
		transform: translateY(-2px) scale(1.02);
		box-shadow: 0 12px 28px -4px rgba(245, 158, 11, 0.6);
		color: #0F172A;
	}

	.btn-arrow {
		transition: transform 0.25s ease;
	}

	.promo-btn:hover .btn-arrow {
		transform: translateX(4px);
	}

	/* Shimmering diagonal light sweep on button */
	.btn-shimmer {
		position: absolute;
		top: 0;
		left: -120%;
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
		animation: shimmer-sweep 3.5s infinite;
	}

	@keyframes shimmer-sweep {
		0% { left: -120%; }
		30%, 100% { left: 120%; }
	}

	.promo-subnote {
		margin-top: 0.65rem;
		font-size: 0.78rem;
		color: #64748B;
	}

	/* Responsive Breakpoints */
	@media (max-width: 860px) {
		.promo-card {
			flex-direction: column;
			text-align: left;
			padding: 2rem 1.5rem;
			gap: 1.75rem;
		}

		.promo-content {
			width: 100%;
		}

		.promo-action {
			width: 100%;
			max-width: 100%;
			align-items: stretch;
		}

		.floating-icon-wrapper {
			display: none;
		}
	}

	@media (max-width: 480px) {
		.promo-banner-section {
			padding: 2rem 1rem 1rem 1rem;
		}

		.promo-card {
			border-radius: 1.15rem;
			padding: 1.6rem 1.25rem;
		}

		.promo-title {
			font-size: 1.25rem;
		}

		.promo-desc {
			font-size: 0.88rem;
		}

		.pill {
			font-size: 0.72rem;
		}

		.promo-btn {
			font-size: 0.92rem;
			padding: 0.8rem 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.orb-1, .orb-2, .pulse-dot, .floating-icon-wrapper, .sparkle-emoji, .btn-shimmer {
			animation: none !important;
		}
		.promo-card, .promo-btn {
			transition: none !important;
		}
	}
</style>
